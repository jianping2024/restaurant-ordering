[Unit]
Description=Mesa on-prem daily cutover (nightly close + local backup)
After=mesa-on-prem.service docker.service network-online.target
Wants=mesa-on-prem.service

[Service]
Type=oneshot
Environment=MESA_HOME=__MESA_HOME__
WorkingDirectory=__ONPREM_DIR__
ExecStart=__ONPREM_DIR__/scripts/daily-cutover.sh
