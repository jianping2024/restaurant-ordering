# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (`.env*` also covers `.env*.local`; keep example tracked)
.env*
!.env.local.example
!deploy/on-prem/.env.example
!deploy/on-prem/vendor/supabase-docker/.env.example
!deploy/on-prem/config/backup.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli local state
supabase/.branches/

# supabase cli local cache
supabase/.temp/

# local agent / IDE
.claude/

# Turborepo
.turbo

# cloud → staging sync artifacts (may contain production data)
.sync-tmp/

# local git worktrees (full checkouts; do not commit)
.worktrees/

# Local data exports (may contain password hashes)
local/

# Auth recovery codes (secrets; never commit)
recovery-codes.txt

# Local tooling / on-prem build artifacts (binaries, secrets, release dumps)
.tools/
/dist/
# Track deploy/on-prem source in git; exclude secrets & runtime data only.
deploy/on-prem/.env
deploy/on-prem/.env.*
!deploy/on-prem/.env.example
deploy/on-prem/backups/
deploy/on-prem/.releases/
deploy/on-prem/logs/
deploy/on-prem/data/
deploy/on-prem/vendor/supabase-docker/volumes/

# Local one-off UAT scripts (hardcoded restaurant/role/accounts; not for CI)
scripts/rbac-kitchen-perm-uat.mjs

# On-prem license runtime config (written by /setup apply-claim)
.mesa-license.local.json
**/.mesa-license.local.json
