# Mesa on-prem backup upload (step ⑥a). Copy to:
#   MESA_HOME/config/backup.env   (Windows install)
#   or deploy/on-prem/config/backup.env (dev Mode B)
# Never commit real secrets. ACL: Administrators / SYSTEM only on Windows.

# restic repository URL (S3 example)
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket/mesa-backups
# RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/your-bucket/mesa-backups

RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# S3 / R2 credentials (when using s3: repository)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Optional
# MESA_INSTANCE_ID=   # else read from deploy/on-prem/.env
# MESA_BACKUP_REMOTE_KEEP_DAYS=14
# MESA_BACKUP_LOCAL_KEEP=7
