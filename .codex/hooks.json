{
  "description": "Mesa shared delivery gates (same scripts/agent-gates/gate.sh as Claude Code).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/agent-gates/gate.sh\" hook-commit",
            "timeout": 30,
            "statusMessage": "Checking commit gate (lint+typecheck)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/agent-gates/gate.sh\" hook-push",
            "timeout": 30,
            "statusMessage": "Checking push gate (build paused)"
          }
        ]
      }
    ]
  }
}
