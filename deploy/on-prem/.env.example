# Generated by scripts/bootstrap-mode-b.sh — do not commit real secrets.
# Copy flow: run bootstrap-mode-b.sh (preferred) instead of hand-editing.

# Core Mesa
MESA_ON_PREM=1
MESA_EDGE_PORT=80
MESA_WEB_PORT=3000
# Edge origin (LAN). Browser uses window.location.origin when SAME_ORIGIN=1.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1
NEXT_PUBLIC_MESA_SUPABASE_SAME_ORIGIN=1
PRINT_AGENT_JWT_SECRET=
STAFF_SESSION_SECRET=
ORDER_ENQUEUE_SECRET=
CRON_SECRET=

# Optional Cloudflare Tunnel public origin (Auth redirect allowlist only).
# Bootstrap: MESA_TUNNEL_ORIGIN=https://pirata.example.com ./scripts/bootstrap-mode-b.sh
# MESA_TUNNEL_ORIGIN=

# Platform license (ADR-004) — set after Ops issues install code + claim
# Must match Vercel Ops MESA_LICENSE_LEASE_SECRET
MESA_PLATFORM_LICENSE_URL=https://restaurant-ordering-ops.vercel.app
# MESA_LICENSE_CHECKIN_CREDENTIAL=
# MESA_LICENSE_LEASE_SECRET=

# Same-origin edge (filled by bootstrap) — NOT :8000
# SUPABASE_PUBLIC_URL=http://127.0.0.1
# SITE_URL=http://127.0.0.1
# API_EXTERNAL_URL=http://127.0.0.1/auth/v1
# ADDITIONAL_REDIRECT_URLS=http://127.0.0.1/**,https://tunnel.example.com/**
# ANON_KEY=
# SERVICE_ROLE_KEY=
# POSTGRES_PASSWORD=
# JWT_SECRET=
# POSTGRES_PORT=54329

# Full self-hosted keys: see vendor/supabase-docker/.env.example
